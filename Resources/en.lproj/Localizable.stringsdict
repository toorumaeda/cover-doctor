<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Fix %lld covers</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>Fix %lld cover</string>
            <key>other</key><string>Fix %lld covers</string>
        </dict>
    </dict>
    <key>Fixed %lld covers</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>Fixed %lld cover</string>
            <key>other</key><string>Fixed %lld covers</string>
        </dict>
    </dict>
    <key>Restored %lld covers</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>Restored %lld cover</string>
            <key>other</key><string>Restored %lld covers</string>
        </dict>
    </dict>
    <key>This replaces %lld cover images (albums and playlists) on your iPhone. The original images are saved on this Mac, so you can undo this later.</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>This replaces %lld cover image (an album or a playlist) on your iPhone. The original image is saved on this Mac, so you can undo this later.</string>
            <key>other</key><string>This replaces %lld cover images (albums and playlists) on your iPhone. The original images are saved on this Mac, so you can undo this later.</string>
        </dict>
    </dict>
</dict>
</plist>
